synonym: "resistant to non-ionic osmotic stress" EXACT []
is_a: PHIPO:0001302 ! resistance to osmotic stress
created_by: alaynecuzick
creation_date: 2023-06-30T12:55:08Z

[Term]
id: PHIPO:0001306
