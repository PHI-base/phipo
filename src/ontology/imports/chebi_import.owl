AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CHEBI_81758> "CHEBI:81758")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/CHEBI_81758> <http://purl.obolibrary.org/obo/chebi/3_STAR>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_81758> "cyproconazole")
