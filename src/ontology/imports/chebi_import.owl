# Class: <http://purl.obolibrary.org/obo/CHEBI_35862> (bacitracin A)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_35862> "A homodetic cyclic peptide consisting of (4<i>R</i>)-2-[(1<i>S</i>,2<i>S</i>)-1-amino-2-methylbutyl]-4,5-dihydro-1,3-thiazole-4-carboxylic acid attached head-to-tail to <small>L</small>-leucyl,<small>D</small>-glutamyl, <small>L</small>-lysyl, <small>D</small>-ornityl, <small>L</small>-isoleucyl, <small>D</small>-phenylalanyl, <small>L</small>-histidyl. <small>D</small>-aspartyl and <small>L</small>-asparaginyl residues coupled in sequence and cyclised by condensation of the side-chain amino group of the <small>L</small>-lysyl residue with the C-terminal carboxylic acid group. It is the major component of bacitracin.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/CHEBI_35862> "chebi_ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "chemidplus") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CHEBI_35862> "Bacitracin A2a")
